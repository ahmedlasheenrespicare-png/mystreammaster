# مكتبة PHP داخلية للوسائط (scoreboard / match-center / standings).
# تُضمَّن عبر require_once من نظام الملفات، فلا تحتاج — ولا يجوز — أن تُخدَم
# عبر HTTP. الحجب هنا يخص طلبات الويب فقط، ولا يمنع تضمين الملفات داخل PHP.
<IfModule mod_authz_core.c>
    <FilesMatch "\.(php|inc|json|md)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(php|inc|json|md)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>
