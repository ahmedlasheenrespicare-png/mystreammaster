# ============================
# .htaccess كامل لـ Hostinger - Stream Master Pro
# نسخة مُحدَّثة أمنياً — رؤوس أمان كاملة + حماية البروكسي ولوحة التحكم
# انسخ هذا الملف كاملاً وضعه في public_html/.htaccess (اعمل نسخة احتياطية من القديم أولاً)
# ============================

# 1) إصلاح CSP للسماح بتشغيل قنوات HLS المجانية
<IfModule mod_headers.c>
Header unset Content-Security-Policy
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.onesignal.com https://cdn.jsdelivr.net https://pagead2.googlesyndication.com https://*.googlesyndication.com https://cdn.ampproject.org; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; media-src 'self' https: blob:; connect-src 'self' https: blob:; frame-src 'self' https://googleads.g.doubleclick.net https://*.googlesyndication.com; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
Header unset X-Frame-Options
Header always set X-Frame-Options "SAMEORIGIN"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), interest-cohort=()"
Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" env=HTTPS
Header always set Cross-Origin-Opener-Policy "same-origin"

# لا تخزين لصفحات الإدارة والبروكسي
<FilesMatch "^(proxy\.php)$">
  Header always set Cache-Control "no-store"
  Header always set X-Robots-Tag "noindex, nofollow"
</FilesMatch>
<FilesMatch "^(scoreboard\.php)$">
  Header always set X-Robots-Tag "noindex, nofollow"
</FilesMatch>

# 1.1) وسيط التضمين (مشغّل البث الخاص في /player.html)
#      الوثيقة المُضمَّنة لا تخضع لسياسة الموقع ولا لقيود التأطير (وإلا حُجب
#      المشغّل داخل الإطار) — embed.php نفسه يرسل سياسة أمان خاصة به عبر
#      ترويسة Content-Security-Policy ووسم <meta> داخل المستند.
<FilesMatch "^embed\.php$">
  Header unset Content-Security-Policy
  Header unset X-Frame-Options
  Header unset Cross-Origin-Opener-Policy
  Header unset Strict-Transport-Security
  Header always unset Content-Security-Policy
  Header always unset X-Frame-Options
  Header always unset Cross-Origin-Opener-Policy
  Header always set Cache-Control "no-store"
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
</FilesMatch>
</IfModule>

# 2) تفعيل الضغط والتخزين المؤقت (Hostinger LiteSpeed)
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType image/jpg "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/avif "access plus 1 year"
ExpiresByType video/mp4 "access plus 1 year"
ExpiresByType application/vnd.apple.mpegurl "access plus 1 hour"
</IfModule>

# 3) إعادة التوجيه للصفحات النظيفة (Astro Static)
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# 3.0) نطاق واحد: www → بدون www (301 دائم)
#      بعد 90 يوماً من البيانات ظهرت نسختان مفهرستان من كل صفحة على www
#      (10 نقرات و84 ظهوراً) — الوسم canonical وحده لم يكفِ. القاعدة هنا
#      تُوحّد الإشارة وتنهي المحتوى المكرر بين النطاقين.
RewriteCond %{HTTP_HOST} ^www\.streammasterstore\.com$ [NC]
RewriteRule ^ https://streammasterstore.com%{REQUEST_URI} [R=301,L]

# 3.1) مشغّل البث الخاص: /player/<مسار> يمر عبر وسيط التضمين (embed.php)
#      فيبقى مصدر المشغّل على نفس النطاق (بلا تعديل في CSP ولا رابط نفق ظاهر).
#      القاعدة قبل فحص وجود الملف حتى لا يُخدَم /player/ كمجلد.
RewriteRule ^player/(.*)$ embed.php?u=player&p=/$1 [L,QSA]

# 3.2) مكتبة قديمة عالقة على الاستضافة (لا يمكن كتابتها عبر FTP) — يُحظر
#      الوصول المباشر إليها (403) حتى لا يُخدَم أي محتوى قديم من lib/.
RewriteRule ^lib(/|$) - [F,L]

# 3.3) تحويلات 301 لهيكلة الموقع الجديدة (أكتوبر 2026)
#      تحليل مباريات UCL → مركز المباراة (فقط إذا لم يوجد ملف/مجلد فعلي)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^match-analysis/?$ /match-center/ [R=301,L]
#      صفحات تحليل UCL القديمة → مركز المباراة
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^roma-real-madrid(/.*)?$ /matches/%D8%AF%D9%88%D8%B1%D9%8A-%D8%A3%D8%A8%D8%B7%D8%A7%D9%84-%D8%A3%D9%88%D8%B1%D9%88%D8%A8%D8%A7/roma-real-madrid/ [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^manchester-city-psg(/.*)?$ /matches/%D8%AF%D9%88%D8%B1%D9%8A-%D8%A3%D8%A8%D8%B7%D8%A7%D9%84-%D8%A3%D9%88%D8%B1%D9%88%D8%A8%D8%A7/manchester-city-psg/ [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^manchester-united-atletico(/.*)?$ /matches/%D8%AF%D9%88%D8%B1%D9%8A-%D8%A3%D8%A8%D8%B7%D8%A7%D9%84-%D8%A3%D9%88%D8%B1%D9%88%D8%A8%D8%A7/manchester-united-atletico/ [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^galatasaray-barcelona(/.*)?$ /matches/%D8%AF%D9%88%D8%B1%D9%8A-%D8%A3%D8%A8%D8%B7%D8%A7%D9%84-%D8%A3%D9%88%D8%B1%D9%88%D8%A8%D8%A7/galatasaray-barcelona/ [R=301,L]

# 3.4) هيكل قديم: /servers/<code>/ — بقايا ما قبل إعادة التصميم.
#      الصفحات لم تعد موجودة، وGoogle ما زال يرسل إليها نقرات فتصل إلى 404
#      (تقرير الصفحات 23 أكتوبر: 37 نقرة و548 ظهوراً على سبعة روابط ميتة،
#      أعلاها /servers/istar/ بـ18 نقرة بينما /istar/ الحيّة عند صفر).
#      تُحوَّل 301 إلى الصفحة الحيّة، وغير المتاح (hulk/shark/falcon/aronium)
#      إلى صفحة المقارنة — ولا تُعاد كتابة محتوى سيرفرات لم يعد الموقع يعرضها.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^servers/(istar|nova|moka|x)/?$ /$1/ [R=301,L,NC]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^servers/[a-z0-9_-]+/?$ /servers/ [R=301,L,NC]

# لا تعيد توجيه الملفات الموجودة
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# للصفحات بدون .html (مثلاً /live-free -> /live-free.html)
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# صفحة 404 مخصصة
ErrorDocument 404 /404.html
</IfModule>

# 4) حماية ملفات حساسة
<FilesMatch "^\.ht|^NEW_ADMIN_PASSWORD\.txt$|^_dashboard\.html$|\.(md|yml|yaml|log|bak|sql|env)$">
Require all denied
</FilesMatch>

# 4.1) منع ربط البروكسي من مواقع خارجية (hotlink protection)
<IfModule mod_rewrite.c>
RewriteCond %{HTTP_REFERER} !^$
RewriteCond %{HTTP_REFERER} !^https?://(www\.)?streammasterstore\.com/ [NC]
RewriteRule ^proxy\.php$ - [F,L]
</IfModule>

# 5) منع تصفح المجلدات
Options -Indexes

# 6) السماح بـ HLS m3u8
<IfModule mod_mime.c>
AddType application/vnd.apple.mpegurl .m3u8
AddType video/mp2t .ts
</IfModule>

# 7) Private source data: outside public_html; verified via PHP on Hostinger.
SetEnv SM_DATA_DIR "/home/u140303745/domains/streammasterstore.com/sm-data"
